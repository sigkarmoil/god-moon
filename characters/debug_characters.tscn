[sub_resource type="Shader" id="Shader_1"]
code = "shader_type canvas_item;
uniform float vulnerable : hint_range(0.0, 1.0) = 0.0;
void fragment() {
	vec4 col = texture(TEXTURE, UV);
	COLOR = mix(col, vec4(1.0, 0.0, 0.0, col.a), vulnerable);
}"

